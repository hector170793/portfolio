# Resend - email delivery (https://resend.com)
# Used by: app/actions/contact.ts, app/actions/newsletter.ts, lib/resend.ts
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address where contact form submissions are delivered
CONTACT_DEST_EMAIL=hector170793@gmail.com

# Cloudflare Turnstile - invisible CAPTCHA (https://dash.cloudflare.com)
# SITE_KEY is public (safe to expose in client bundles)
# SECRET_KEY is server-only (never commit real values)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend Audiences - newsletter list ID
# Found in Resend dashboard > Audiences > your audience ID
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
